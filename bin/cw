#!/usr/bin/env bash

set -euo pipefail

# Where one-shot runs write their durable logs (NOT /tmp — kept around so a
# finished run can be looked up later). Override with CW_LOG_DIR.
CW_LOG_DIR="${CW_LOG_DIR:-$HOME/.cw/logs}"

# How long `cw wait` keeps looking for a log that doesn't exist yet (seconds).
# `cw oneshot` returns as soon as it has handed the command to its tmux pane, so
# a script that launches and then waits can get there before the log does.
CW_WAIT_LOG_GRACE="${CW_WAIT_LOG_GRACE:-30}"

# Line cw_oneshot_run appends to a log when the run is over, carrying its exit
# code. It's the one end-of-run signal that survives claude dying before it can
# emit a stream-json `result` event, and what `cw wait` blocks on.
CW_EXIT_PREFIX="cw: oneshot exit "

# --- options ---------------------------------------------------------------
# Value-taking flags recognised anywhere in the argv — before or after the
# action word — so `cw --base foo review bar` and `cw review --base foo bar`
# are the same command. Each line is "<flag>:<name>"; main() parses the flag and
# stores its value in a local named opt_<name>, which bash's dynamic scoping
# makes readable from every action (and from _cw_prepare). Add a new option by
# adding one line here and reading opt_<name> where it matters.
CW_VALUE_OPTS="
--base:base
--timeout:timeout
"

# _cw_opt_var <flag>
# Echo the opt_<name> suffix a value-taking flag stores into, or nothing if the
# flag isn't one of them.
_cw_opt_var() {
  awk -F: -v f="$1" '$1 == f { print $2; exit }' <<< "$CW_VALUE_OPTS"
}

# cw install
# Prepares a worktree by checking the main working tree for a local
# .local/cw_install.sh. If present, runs it with the current worktree as its
# working directory. The script is a per-machine, untracked setup step (deps,
# configs) that a fresh pool worktree wouldn't otherwise have; running the
# canonical copy in the main tree keeps a single source of truth.
cw_install() {
  local main_root worktree src
  worktree="$(git rev-parse --show-toplevel)" || return 1
  # First entry of `git worktree list` is the main working tree — same idiom used
  # by cw_close / cw_clean.
  main_root="$(git worktree list | awk 'NR==1{print $1}')" || return 1
  src="$main_root/.local/cw_install.sh"

  if [ ! -f "$src" ]; then
    echo "cw install: no .local/cw_install.sh in $main_root; nothing to do"
    return 0
  fi

  # Pass the main working tree path as $1 so the script can reach the original
  # repo (e.g. to copy over untracked local files).
  echo "cw install: running $src"
  ( cd "$worktree" && bash "$src" "$main_root" )
}

# --- worktree pool ---------------------------------------------------------
# cw keeps a pool of reusable worktrees named cw-worktree-N under
# <repo>-worktrees. An idle ("parked") worktree sits in detached HEAD at trunk;
# a busy one is checked out on a branch. Reusing a parked worktree keeps its
# node_modules and other ignored artifacts around for a fast warm `cw install`.

# _cw_pool_base
# Echo the worktree pool base dir (<repo_parent>/<repo_name>-worktrees),
# derived from the main working tree (first entry of `git worktree list`).
_cw_pool_base() {
  local main_root
  main_root="$(git worktree list | awk 'NR==1{print $1}')" || return 1
  echo "$(dirname "$main_root")/$(basename "$main_root")-worktrees"
}

# _cw_list_parked
# Echo the path of every parked pool worktree, one per line: a worktree whose
# leaf matches cw-worktree-N, that lives under the pool base, and is in detached
# HEAD (no branch). Busy worktrees (on a branch) are skipped.
_cw_list_parked() {
  local base
  base="$(_cw_pool_base)" || return 1
  git worktree list --porcelain | awk -v base="$base" '
    function flush() {
      if (path != "" && detached && !branch) {
        n = split(path, parts, "/"); leaf = parts[n]
        if (leaf ~ /^cw-worktree-[0-9]+$/ && index(path, base "/") == 1) print path
      }
      path = ""; detached = 0; branch = 0
    }
    /^worktree /  { flush(); path = substr($0, 10) }
    /^detached$/  { detached = 1 }
    /^branch /    { branch = 1 }
    END           { flush() }
  '
}

# _cw_find_parked
# Echo the path of the first parked pool worktree, or nothing if none is free.
_cw_find_parked() {
  local all
  all="$(_cw_list_parked)"
  echo "${all%%$'\n'*}"
}

# _cw_next_n
# Echo the next free pool number: one past the highest cw-worktree-N seen among
# both registered worktrees and any leftover dirs under the base.
_cw_next_n() {
  local base leaf n max=0 path
  base="$(_cw_pool_base)" || return 1

  while IFS= read -r path; do
    leaf="${path##*/}"
    if [[ "$leaf" =~ ^cw-worktree-([0-9]+)$ ]]; then
      n="${BASH_REMATCH[1]}"
      if (( n > max )); then max=$n; fi
    fi
  done < <(git worktree list --porcelain | awk '/^worktree /{print substr($0, 10)}')

  if [ -d "$base" ]; then
    for path in "$base"/cw-worktree-*; do
      [ -e "$path" ] || continue
      leaf="${path##*/}"
      if [[ "$leaf" =~ ^cw-worktree-([0-9]+)$ ]]; then
        n="${BASH_REMATCH[1]}"
        if (( n > max )); then max=$n; fi
      fi
    done
  fi

  echo $(( max + 1 ))
}

# _cw_window_name <branch>
# Echo the tmux window name for <branch>: the branch name itself, except that
# branches shaped like colton/act-123-whatever collapse to the ticket id
# (ACT-123). One-shot log filenames are derived from this too, which is how
# `cw wait <branch>` finds the log of a run it didn't start.
_cw_window_name() {
  local branch="$1"
  if [[ "$branch" =~ ^[a-z]+/([a-z]+-[0-9]+)-.* ]]; then
    echo "${BASH_REMATCH[1]}" | tr '[:lower:]' '[:upper:]'
  else
    echo "$branch"
  fi
}

# _cw_prepare <branch>
# Shared setup for both open modes: computes the tmux window name, acquires a
# pool worktree (reusing a parked one or creating a fresh cw-worktree-N),
# fetches origin, resolves trunk, and points the worktree at <branch>. Sets the
# caller's window/worktree/trunk locals — declare them `local` before calling.
#
# Reads $opt_base (the --base flag, see CW_VALUE_OPTS) via dynamic scoping from
# main(): the branch a NEW <branch> is created from and stacked on.
_cw_prepare() {
  local branch="$1"
  local base="${opt_base:-}"

  window="$(_cw_window_name "$branch")"

  # Fetch so we know whether the branch exists on origin, and so we base
  # new branches on the latest trunk.
  git fetch origin --quiet

  # trunk is needed both for basing new branches and for `git stack parent`.
  trunk="$(git stack trunk)"
  if [ -z "$trunk" ]; then
    echo "cw: could not determine origin's default branch" >&2
    return 1
  fi

  # Does the requested branch already exist? Decided up front because it also
  # decides whether --base applies: re-opening an existing branch never rebases
  # or re-parents it, so its base is irrelevant and the flag is ignored.
  local exists=0
  if git show-ref --verify --quiet "refs/heads/$branch" ||
      git ls-remote --exit-code --heads origin "$branch" >/dev/null 2>&1; then
    exists=1
  fi

  # Start point for a new branch: --base when given, else the latest trunk.
  # Resolved and validated *before* acquiring a worktree so a bad --base fails
  # without leaving a freshly created worktree behind.
  local base_ref="$trunk"
  if [ "$exists" -eq 0 ] && [ -n "$base" ]; then
    if ! git show-ref --verify --quiet "refs/heads/$base"; then
      if git rev-parse --verify --quiet "refs/remotes/origin/$base" >/dev/null; then
        # Remote-only base: materialise it locally. It has to be a local ref to
        # serve as a `git stack parent` target, which git-stack requires.
        git branch --quiet --track "$base" "origin/$base" || return 1
      else
        echo "cw: base branch '$base' does not exist locally or on origin" >&2
        return 1
      fi
    fi
    base_ref="$base"
  fi

  # Acquire a worktree from the pool: reuse a parked (detached) one if any,
  # otherwise create a fresh cw-worktree-N detached at trunk.
  worktree="$(_cw_find_parked)"
  if [ -z "$worktree" ]; then
    local base n
    base="$(_cw_pool_base)" || return 1
    n="$(_cw_next_n)" || return 1
    worktree="$base/cw-worktree-$n"
    git worktree add --detach "$worktree" "$trunk" || return 1
  fi

  # Point the acquired worktree at the requested branch. `git switch` reconciles
  # tracked files while leaving ignored artifacts (node_modules, .clasp.json)
  # in place. If the branch is already checked out in another worktree, this
  # fails — same "can't open a branch twice" behavior as before.
  if [ "$exists" -eq 1 ]; then
    # Branch already exists: pull it from origin and switch to it.
    git fetch origin "$branch:$branch" 2>/dev/null || git branch -f "$branch" "origin/$branch"
    git -C "$worktree" switch "$branch" || return 1
  else
    # New branch, based on --base (or the latest trunk) and recorded as stacked
    # on it so `git stack` sees it. The ref check keeps the parent step from
    # failing the whole open when trunk has no local branch — git-stack only
    # accepts a local branch as a parent.
    git -C "$worktree" switch -c "$branch" "$base_ref" || return 1
    if git show-ref --verify --quiet "refs/heads/$base_ref"; then
      git -C "$worktree" stack parent "$base_ref" || return 1
    fi
  fi
}

# cw <branch> [prompt]
# Opens a new tmux window running a fresh interactive claude session in a git
# worktree on <branch>, with a second pane for setup. For a headless, logged run
# that tears itself down, see `cw oneshot`.
cw() {
  local branch="${1:-}"
  local prompt="${2:-}"

  if [ -z "$branch" ]; then
    echo "usage: cw <branch> [prompt]" >&2
    return 1
  fi

  local window worktree trunk
  _cw_prepare "$branch" || return 1

  # Open a new tmux window with an empty shell, then type the claude command
  # into it — when claude exits you're back at the shell, so the pane stays. A
  # second pane handles setup.
  local win_id cmd
  win_id="$(tmux new-window -P -F '#{window_id}' -n "$window" -c "$worktree")"
  cmd="claude"
  [ -n "$prompt" ] && cmd="claude --permission-mode auto $(printf '%q' "$prompt")"
  tmux send-keys -t "$win_id.0" "$cmd" Enter
  tmux split-window -v -t "$win_id" -c "$worktree"
  tmux send-keys -t "$win_id.1" 'cw install && echo "run cw close to park this worktree and close the window"' Enter
  tmux select-pane -t "$win_id.0"
}

# cw oneshot <branch> <prompt>
# Headless one-shot: sets up the worktree, then runs setup + `claude -p <prompt>`
# in a single pane, tees all output to a durable log under $CW_LOG_DIR, and tears
# the worktree/window down when claude exits. The pane runs `cw __oneshot`
# (cw_oneshot_run) to do the actual work.
cw_oneshot() {
  local branch="${1:-}"
  local prompt="${2:-}"

  if [ -z "$branch" ]; then
    echo "usage: cw oneshot <branch> <prompt>" >&2
    return 1
  fi
  if [ -z "$prompt" ]; then
    echo "cw: oneshot requires a prompt" >&2
    return 1
  fi

  local window worktree trunk
  _cw_prepare "$branch" || return 1

  mkdir -p "$CW_LOG_DIR"
  # Flatten slashes: branches like chore/foo keep their slash in $window
  # (only ticket-shaped branches get rewritten to ACT-123), and a slash in
  # the filename would point tee at a nonexistent subdir under $CW_LOG_DIR,
  # so it writes nothing.
  local log
  log="$CW_LOG_DIR/${window//\//-}-$(date +%Y%m%d-%H%M%S).log"
  echo "cw: one-shot logging to $log"

  # Ship only a short invocation to the pane; the actual pipeline lives in
  # cw_oneshot_run so it can be written as normal bash. printf %q quotes the
  # args for the trip through the pane's shell.
  # -d: create the window in the background without switching the client to it,
  # so a one-shot run doesn't yank focus away from what you're doing.
  local win_id
  win_id="$(tmux new-window -d -P -F '#{window_id}' -n "$window" -c "$worktree")"
  tmux send-keys -t "$win_id.0" \
    "$(printf 'cw __oneshot %q %q %q %q' "$branch" "$prompt" "$log" "$trunk")" Enter
}

# cw __oneshot <branch> <prompt> <log> <trunk>
# Internal: runs inside the one-shot pane created by `cw oneshot`. Not part of
# the public interface (not in usage()). Runs setup + headless claude, tees all
# output to the durable log, then tears the worktree/window down.
#
# NB: call cw_install / cw_close directly, NOT `cw install` / `cw close`. This
# runs in-process where `cw` resolves to the window-opening shell function, not
# the dispatcher — `cw install` would spawn a stray normal window.
cw_oneshot_run() {
  local branch="$1" prompt="$2" log="$3" trunk="$4"
  local status=0
  {
    echo "Starting $branch" &&
    date &&
    cw_install &&
    echo "Starting claude..." &&
    claude --output-format stream-json --verbose --permission-mode auto -p "$prompt" &&
    echo "Finishing $branch" &&
    date
  } 2>&1 | tee "$log" || status=$?
  # `|| status=$?` does double duty: it stops `set -e` from killing the script
  # the instant claude/setup fails (which would skip the notify + teardown
  # below), and captures the failing exit code. With `pipefail` on and tee
  # effectively never failing, this is the pipeline body's status.
  #
  # Record the outcome in the log itself (see CW_EXIT_PREFIX): claude only emits
  # a `result` event when it gets that far, so a run that dies during setup would
  # otherwise leave a log that's indistinguishable from one still running.
  # `cw wait` blocks on this line and exits with the code it carries.
  printf '%s%s\n' "$CW_EXIT_PREFIX" "$status" | tee -a "$log"
  # if [ "$status" -eq 0 ]; then
  #   cnotify -s Glass "$branch finished" "cw one-shot" || true
  # else
  #   cnotify -s Basso "$branch failed (exit $status)" "cw one-shot" || true
  # fi
  cw_close
}

# --- wait ------------------------------------------------------------------

# _cw_newest_log [<substring>]
# Echo the newest log under $CW_LOG_DIR whose filename contains <substring>
# (the newest log of all when it's empty). Returns 1 with no output on no match.
_cw_newest_log() {
  local pat="${1:-}" path
  # ls -t sorts newest-first; log filenames are branch+timestamp, so no newlines.
  while IFS= read -r path; do
    [ -f "$path" ] || continue
    if [ -z "$pat" ] || [[ "${path##*/}" == *"$pat"* ]]; then
      echo "$path"
      return 0
    fi
  done < <(ls -t -- "$CW_LOG_DIR"/*.log 2>/dev/null || true)
  return 1
}

# _cw_log_exit <log>
# Echo the exit status of the run that wrote <log>, or return 1 if it's still
# going. The authority is the terminator line cw_oneshot_run appends; logs from
# before that existed (or a pane killed between claude finishing and the append)
# fall back to the stream-json `result` event, which carries success/failure but
# not the code.
_cw_log_exit() {
  local log="$1" line
  line="$(grep -a "^$CW_EXIT_PREFIX" "$log" 2>/dev/null | tail -n 1 || true)"
  if [ -n "$line" ]; then
    echo "${line##* }"
    return 0
  fi
  # Match only the `result` event's own is_error; tool_result blocks carry an
  # is_error field too, so grepping the whole log for it would report a run as
  # failed just because one tool call inside it errored.
  line="$(grep -a '"type"[[:space:]]*:[[:space:]]*"result"' "$log" 2>/dev/null | tail -n 1 || true)"
  if [ -n "$line" ]; then
    case "$line" in
      *'"is_error"'*:*true*) echo 1 ;;
      *) echo 0 ;;
    esac
    return 0
  fi
  return 1
}

# cw wait [--timeout <secs>] [<branch>|<log>]
# Blocks until a one-shot run finishes, streaming its log through cwtail while
# it waits, and exits with the run's own status — so launching and waiting
# composes:
#
#   cw oneshot chore/foo "do the thing" && cw wait chore/foo && gh pr create …
#
# <branch>|<log> picks the run: a log path, a branch name (mapped through
# _cw_window_name, since that's what the log is named after), or any substring
# of a log filename. Omit it to wait on the newest log in $CW_LOG_DIR. Waiting
# on an already-finished run just renders its log and returns that status.
cw_wait() {
  local target="${1:-}"
  local timeout="${opt_timeout:-0}"
  if ! [[ "$timeout" =~ ^[0-9]+$ ]]; then
    echo "cw wait: --timeout takes whole seconds, got '$timeout'" >&2
    return 1
  fi

  # A path wins outright. Otherwise try the branch's window name first (an exact
  # log-name prefix) and the raw target second, so `cw wait ACT-123`,
  # `cw wait colton/act-123-thing` and `cw wait chore/foo` all resolve.
  local log=""
  local -a pats=("")
  if [ -n "$target" ] && [ -f "$target" ]; then
    log="$target"
  elif [ -n "$target" ]; then
    local window
    window="$(_cw_window_name "$target")"
    pats=("${window//\//-}" "${target//\//-}")
  fi

  local waited=0 pat
  while [ -z "$log" ]; do
    for pat in "${pats[@]}"; do
      log="$(_cw_newest_log "$pat" || true)"
      [ -n "$log" ] && break
    done
    [ -n "$log" ] && break
    if [ "$waited" -ge "$CW_WAIT_LOG_GRACE" ]; then
      echo "cw wait: no log matching '${target:-(any)}' in $CW_LOG_DIR" >&2
      return 1
    fi
    [ "$waited" -eq 0 ] && echo "cw wait: waiting for a log matching '$target'…" >&2
    sleep 1
    waited=$(( waited + 1 ))
  done

  # Already finished: render it once, no follow, and report the status.
  local status
  if status="$(_cw_log_exit "$log")"; then
    cwtail --no-follow "$log"
    return "$status"
  fi

  # Still running: cwtail follows the log in the background (it renders what's
  # already there first, so you see the whole run) while we poll for the
  # terminator line. Polling here rather than leaning on cwtail's own
  # stop-at-`result` behavior is what makes a run that died before emitting a
  # result event finish the wait instead of hanging it.
  cwtail -f "$log" &
  local tail_pid=$!
  trap 'kill "$tail_pid" 2>/dev/null || true' EXIT

  waited=0
  while :; do
    if status="$(_cw_log_exit "$log")"; then
      sleep 1   # let cwtail render the last few lines before we cut it off
      kill "$tail_pid" 2>/dev/null || true
      wait "$tail_pid" 2>/dev/null || true
      return "$status"
    fi
    if [ "$timeout" -gt 0 ] && [ "$waited" -ge "$timeout" ]; then
      kill "$tail_pid" 2>/dev/null || true
      wait "$tail_pid" 2>/dev/null || true
      echo "cw wait: timed out after ${timeout}s; $log is still running" >&2
      return 124
    fi
    sleep 1
    waited=$(( waited + 1 ))
  done
}

# cw review <branch>
# Code review: opens the worktree + interactive claude running the review.
cw_review() {
  local branch="${1:-}"
  cw "$branch" "/code-review max --comment"
}

# cw review-oneshot <branch>
# One-shot code review: spins up the worktree, runs the review headless, logs
# the output, and tears the worktree/window down when it finishes.
cw_review_oneshot() {
  local branch="${1:-}"
  cw_oneshot "$branch" "/code-review max --comment"
}

# cw close [--remove|-r] [-f|--force]
# Tears down the current cw window and releases its worktree. By default the
# worktree is *parked* (detached at trunk, dir kept with deps) for fast reuse;
# --remove deletes it instead. Legacy branch-named worktrees are always removed.
# Without --force, a worktree with uncommitted/untracked changes refuses, so you
# don't lose work by accident; --force discards those changes.
cw_close() {
  local force="" remove=""
  while [ $# -gt 0 ]; do
    case "$1" in
      -f|--force)  force="--force" ;;
      -r|--remove) remove=1 ;;
    esac
    shift
  done

  local worktree main_root worktrees_base
  worktree="$(git rev-parse --show-toplevel)" || return 1

  # Find the main working tree so we can run git from outside the worktree.
  main_root="$(git worktree list | awk 'NR==1{print $1}')"

  # Only operate on cw worktrees: those living somewhere under <repo>-worktrees,
  # next to the main tree. The first test also refuses to run in the main tree.
  worktrees_base="$(dirname "$main_root")/$(basename "$main_root")-worktrees"
  if [ "$worktree" = "$main_root" ] || [[ "$worktree"/ != "$worktrees_base"/* ]]; then
    echo "cw_close: not inside a cw worktree" >&2
    return 1
  fi

  # Capture this pane's own tmux window before we move away. Target $TMUX_PANE
  # explicitly: with no -t, display-message resolves against the attached
  # client's *focused* window, not the pane we're running in — so a one-shot
  # tearing itself down in the background would otherwise kill whatever window
  # the user is currently looking at.
  local win_id
  win_id="$(tmux display-message -p -t "${TMUX_PANE:-}" '#{window_id}' 2>/dev/null)"

  # Step out of the worktree so operating on its directory is safe.
  cd "$main_root" || return 1

  local leaf="${worktree##*/}"
  if [ -z "$remove" ] && [[ "$leaf" =~ ^cw-worktree-[0-9]+$ ]]; then
    # Park the pool worktree: detach it at trunk so it stays around (with its
    # deps) ready for reuse, releasing whatever branch it was on.
    local trunk
    trunk="$(git -C "$main_root" stack trunk)"
    if [ -z "$trunk" ]; then
      echo "cw_close: could not determine trunk" >&2
      cd "$worktree" 2>/dev/null
      return 1
    fi
    # status --porcelain ignores gitignored files, so node_modules et al. don't
    # count as dirty — only real uncommitted/untracked work blocks a park.
    if [ -n "$(git -C "$worktree" status --porcelain)" ]; then
      if [ -z "$force" ]; then
        echo "cw_close: worktree has uncommitted changes (pass -f to discard, or --remove to delete)" >&2
        cd "$worktree" 2>/dev/null
        return 1
      fi
      # -f: discard tracked changes and untracked files, but keep ignored files
      # (node_modules) so the parked worktree stays warm.
      git -C "$worktree" reset --hard
      git -C "$worktree" clean -fd
    fi
    if ! git -C "$worktree" switch --detach "$trunk"; then
      echo "cw_close: failed to park worktree" >&2
      cd "$worktree" 2>/dev/null
      return 1
    fi
  else
    # Remove entirely: explicit --remove, or a legacy (non-pool) worktree.
    if ! git -C "$main_root" worktree remove $force "$worktree"; then
      echo "cw_close: worktree not removed (pass --force to discard changes)" >&2
      cd "$worktree" 2>/dev/null
      return 1
    fi
  fi

  # Close the tmux window (both panes) if we're inside tmux.
  [ -n "$win_id" ] && tmux kill-window -t "$win_id"
}

# cw clean
# Removes every parked (detached) pool worktree, reclaiming disk. Busy worktrees
# (checked out on a branch) are left untouched. Parked trees are clean, so no
# --force is needed. Runnable from anywhere in the repo.
cw_clean() {
  local main_root path removed=0
  main_root="$(git worktree list | awk 'NR==1{print $1}')"

  while IFS= read -r path; do
    [ -n "$path" ] || continue
    if git -C "$main_root" worktree remove "$path"; then
      removed=$(( removed + 1 ))
      echo "cw clean: removed $path"
    else
      echo "cw clean: could not remove $path" >&2
    fi
  done < <(_cw_list_parked)

  git -C "$main_root" worktree prune
  echo "cw clean: removed $removed parked worktree(s)"
}

usage() {
  cat >&2 <<'EOF'
usage:
  cw [opts] <branch> [prompt]         open a worktree + interactive claude in tmux
  cw oneshot [opts] <branch> <prompt> run claude headless, log output, auto-close
  cw wait [opts] [<branch>|<log>]     block until a one-shot finishes, streaming
                                      its log via cwtail; exits with its status
                                      (defaults to the newest log)
  cw review [opts] <branch>           open a worktree + interactive code review of <branch>
  cw review-oneshot [opts] <branch>   run a code review headless, log output, auto-close
  cw close [--remove] [-f]            park the current cw worktree (reuse later); --remove to delete
  cw clean                            remove all parked (idle) worktrees
  cw install                          prepare the current worktree (deps + configs)

opts (may go before or after the action word, so `cw --base main review foo` and
`cw review --base main foo` are the same):
  --base <branch>   (window-creating actions) create a NEW <branch> from
                    <branch> instead of trunk, and record it as its `git stack`
                    parent. Errors if <branch> exists neither locally nor on
                    origin. Ignored when the branch being opened already exists.
  --timeout <secs>  (wait) give up after <secs> and exit 124 instead of waiting
                    for the run to finish. 0 (the default) waits forever.
EOF
}

# --- argument dispatch ----------------------------------------------------
# Bare words select which action to run; value-taking flags come from
# CW_VALUE_OPTS (--base <v> or --base=<v>, anywhere in the argv); everything
# else is collected as positional args and forwarded to the action. Add a new
# action by extending the case below, a new option by extending CW_VALUE_OPTS.
main() {
  local action="cw"
  local -a positional=()

  # One local per declared option, named opt_<name> and cleared so nothing can
  # leak in from the environment. Declared here (rather than per action) so
  # every action and helper can read them through bash's dynamic scoping.
  local _flag _var
  while IFS=: read -r _flag _var; do
    [ -n "$_var" ] || continue
    eval "local opt_$_var=''"
  done <<< "$CW_VALUE_OPTS"

  while [ $# -gt 0 ]; do
    # A declared value-taking flag, in either --flag value or --flag=value form.
    _var=""
    case "$1" in
      --*=*) _var="$(_cw_opt_var "${1%%=*}")" ;;
      --*)   _var="$(_cw_opt_var "$1")" ;;
    esac
    if [ -n "$_var" ]; then
      case "$1" in
        --*=*) printf -v "opt_$_var" '%s' "${1#*=}" ;;
        *)
          if [ $# -lt 2 ]; then
            echo "cw: $1 requires a value" >&2
            return 1
          fi
          printf -v "opt_$_var" '%s' "$2"
          shift ;;
      esac
      shift
      continue
    fi

    case "$1" in
      oneshot)     action="oneshot" ;;
      wait)           action="wait" ;;
      close)          action="close" ;;
      clean)          action="clean" ;;
      review)         action="review" ;;
      review-oneshot) action="review-oneshot" ;;
      install)     action="install" ;;
      __oneshot)   action="__oneshot" ;;
      -f|--force)  positional+=("$1") ;;
      -r|--remove) positional+=("$1") ;;
      -h|--help)   usage; return 0 ;;
      --)          shift; while [ $# -gt 0 ]; do positional+=("$1"); shift; done; break ;;
      -*)          echo "cw: unknown option: $1" >&2; usage; return 1 ;;
      *)           positional+=("$1") ;;
    esac
    shift
  done

  case "$action" in
    oneshot)   cw_oneshot ${positional[@]+"${positional[@]}"} ;;
    wait)      cw_wait ${positional[@]+"${positional[@]}"} ;;
    close)     cw_close ${positional[@]+"${positional[@]}"} ;;
    clean)     cw_clean ;;
    review)    cw_review ${positional[@]+"${positional[@]}"} ;;
    review-oneshot) cw_review_oneshot ${positional[@]+"${positional[@]}"} ;;
    install)   cw_install ;;
    __oneshot) cw_oneshot_run ${positional[@]+"${positional[@]}"} ;;
    cw)        cw ${positional[@]+"${positional[@]}"} ;;
  esac
}

main "$@"
