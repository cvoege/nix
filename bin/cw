# @cmd    Create a workspace.
# @alias start,c
# @option -b --base <BRANCH>    base a new branch on this instead of trunk
# @option -p --prompt <PROMPT>  Prompt to pass the LLM.
# @flag   -g --background       Do not switch to the window once open
# @arg    branch!               branch to open
create() {
  local branch="${argc_branch:-}"
  local base="${argc_base:-}"
  local prompt="${argc_prompt:-}"
  local background="${argc_background:-}"

  if [ -z "$branch" ]; then
    echo "usage: cw <branch> [prompt]" >&2
    return 1
  fi
  if [ -z "$base" ]; then
    base="$(git stack trunk)"
  fi

  local window worktree

  ct create "$branch" --base "${base}" || return 1
  worktree="$(ct worktree_for_branch "$branch")"
  window="$(_cw_window_name "$branch")"

  local cmd
  cmd="$(_get_agent_basic_cmd "$prompt")"
  if [ "$CW_MULTIPLEXER" = "tmux" ] ; then
    # Open a new tmux window with an empty shell, then type the claude command
    # into it — when claude exits you're back at the shell, so the pane stays. A
    # second pane handles setup.
    local win_id
    win_id="$(tmux new-window -d -P -F '#{window_id}' -n "$window" -c "$worktree")"
    _cw_pin_window_dir_tmux "$win_id" "$worktree"
    tmux send-keys -t "$win_id.0" "$cmd" Enter
    tmux split-window -d -v -t "$win_id" -c "$worktree"
    tmux send-keys -t "$win_id.1" 'echo "run cw close to park this worktree and close the window"' Enter
    if [ -z "$background" ] ; then
      tmux select-window -t "$win_id"
    fi
  elif [ "$CW_MULTIPLEXER" = "herdr" ] ; then
    local top_pane_id tab_create_output split_output bottom_pane_id tab_id agent_create_output agent_name
    # Create tab
    tab_create_output="$(herdr tab create --cwd "$worktree" --label "$window" --env CW_WORKTREE="$worktree" --no-focus)"
    tab_id="$(echo "$tab_create_output" | jq -re .result.tab.tab_id)"
    top_pane_id="$(echo "$tab_create_output" | jq -re .result.root_pane.pane_id)"

    agent_name="$(_cw_agent_name "$window")"
    # Check the tab and pane are live
    herdr tab get "$tab_id" | jq -re '.result.tab'
    herdr pane get "$top_pane_id" | jq -re '.result.pane'
    # Give a second for the agent to start
    sleep 0.1
    _cw_retry 5 1 herdr agent start "$agent_name" --kind "$CW_AGENT" --pane "$top_pane_id" || return 1
    if [ -n "$prompt" ] ; then
      herdr agent prompt "$agent_name" "$prompt"
    fi

    split_output="$(herdr pane split "$top_pane_id" --direction down --no-focus)"
    bottom_pane_id="$(echo "$split_output" | jq -re .result.pane.pane_id)"
    herdr pane run "$bottom_pane_id" "echo "run cw close to park this worktree and close the window""

    if [ -z "$background" ] ; then
      herdr tab focus "$tab_id"
    fi
  else
    echo "Invalid multiplexer $CW_MULTIPLEXER" >&2
    return 1
  fi
}


# _cw_close_workspace <worktree> <force> <remove>
# Release <worktree> via `ct close`, then close its multiplexer tab/window.
# <force> and <remove> are the literal flags ("--force"/"--remove") or empty,
# same convention as `ct close` itself. Shared by `closex` and `close-all`.
_cw_close_workspace() {
  local worktree="$1" force="$2" remove="$3"
  ct close "$worktree" $force $remove

  local win_id tab_id
  if [ "$CW_MULTIPLEXER" = "tmux" ] ; then
    # TODO: Tmux find window
    # tmux kill-window -t "$win_id"
    echo "cw: closing the multiplexer window isn't implemented yet for tmux" >&2
    return 1
  elif [ "$CW_MULTIPLEXER" = "herdr" ] ; then
    # Match on the pane's cwd rather than the tab label: the label is a
    # transformed version of the branch name (see _cw_window_name) and may
    # be further mangled by herdr, but the worktree path is exact and known.
    tab_id="$(herdr pane list | jq -re --arg cwd "$worktree" \
      '.result.panes[] | select(.cwd == $cwd) | .tab_id' | head -1)"
    if [ -z "$tab_id" ]; then
      echo "cw: no herdr tab found for worktree $worktree" >&2
      return 1
    fi
    herdr tab close "$tab_id"
  else
    echo "Invalid multiplexer $CW_MULTIPLEXER" >&2
    return 1
  fi
}

# @cmd Tears down the current cw window and releases its worktree.
# @flag  -f --force   discard uncommitted and untracked changes
# @flag  -r --remove  delete the worktree instead of parking it for reuse
# @arg   spaces*      list of workpsaces to delete
closex() {
  local remove="" force=""
  [ -n "${argc_remove:-}" ] && remove="--remove"
  [ -n "${argc_force:-}" ] && force="--force"

  local space worktree
  for space in "${argc_spaces[@]}" ; do
    echo "$space"
    worktree="$(ct resolve "$space")"
    _cw_close_workspace "$worktree" "$force" "$remove"
  done
}

# @cmd Closes every open cw workspace for the current repo.
# @flag  -f --force   discard uncommitted and untracked changes
# @flag  -r --remove  delete the worktrees instead of parking them for reuse
close-all() {
  local remove="" force=""
  [ -n "${argc_remove:-}" ] && remove="--remove"
  [ -n "${argc_force:-}" ] && force="--force"

  local worktree
  while IFS= read -r worktree; do
    [ -n "$worktree" ] || continue
    echo "$worktree"
    _cw_close_workspace "$worktree" "$force" "$remove"
  done < <(ct list-busy)
}

# @cmd Tears down the current cw window and releases its worktree.
# @flag  -f --force   discard uncommitted and untracked changes
# @flag  -r --remove  delete the worktree instead of parking it for reuse
close() {
  local remove=""
  [ -n "${argc_remove:-}" ] && remove="--remove"
  local force=""
  [ -n "${argc_force:-}" ] && force="--force"

  local main_root worktree win_id

  worktree="$(git rev-parse --show-toplevel 2>/dev/null)" || worktree=""
  if [ -z "$worktree" ]; then
    echo "ct: not inside a git worktree; pass a worktree, branch or path to park" >&2
    return 1
  fi

  main_root="$(ct main_root)"
  # Step out of the worktree so operating on its directory is safe.
  cd "$main_root" || return 1

  ct close "$worktree" $force $remove

  if [ "$CW_MULTIPLEXER" = "tmux" ] ; then
    win_id="$(tmux display-message -p -t "${TMUX_PANE:-}" '#{window_id}' 2>/dev/null)"

    # Close the tmux window (both panes) if we're inside tmux.
    [ -n "$win_id" ] && tmux kill-window -t "$win_id"
  elif [ "$CW_MULTIPLEXER" = "herdr" ] ; then
    herdr tab close "$HERDR_TAB_ID"
  else
    echo "Invalid multiplexer $CW_MULTIPLEXER" >&2
    return 1
  fi
}

# @cmd    Create a background workspace to do one agentic action and quit.
# @option -b --base <BRANCH>     base a new branch on this instead of trunk
# @option -p --prompt! <PROMPT>  Prompt to pass the LLM.
# @arg    branch!                branch to open
oneshot() {
  local branch="${argc_branch:-}"
  local base="${argc_base:-}"
  local prompt="${argc_prompt:-}"

  if [ -z "$branch" ]; then
    echo "usage: cw <branch> [prompt]" >&2
    return 1
  fi
  if [ -z "$base" ]; then
    base="$(git stack trunk)"
  fi

  local window worktree

  ct create "$branch" --base "${base}" || return 1
  worktree="$(ct worktree_for_branch "$branch")"
  window="$(_cw_window_name "$branch")"

  mkdir -p "$CW_LOG_DIR"

  local log
  log="$CW_LOG_DIR/${window//\//-}-$(date +%Y%m%d-%H%M%S).log"
  echo "cw: one-shot logging to $log"


  if [ "$CW_MULTIPLEXER" = "tmux" ] ; then
    local win_id
    win_id="$(tmux new-window -d -P -F '#{window_id}' -n "$window" -c "$worktree")"
    _cw_pin_window_dir_tmux "$win_id" "$worktree"
    tmux send-keys -t "$win_id.0" \
      "$(printf 'cw __oneshot %q %q %q' "$branch" "$prompt" "$log")" Enter
  elif [ "$CW_MULTIPLEXER" = "herdr" ] ; then
    local top_pane_id tab_create_output
    # Create tab
    tab_create_output="$(herdr tab create --cwd "$worktree" --label "$window" --env CW_WORKTREE="$worktree" --no-focus)"
    top_pane_id="$(echo "$tab_create_output" | jq -re .result.root_pane.pane_id)"

    herdr pane run "$top_pane_id" "$(printf 'cw __oneshot %q %q %q' "$branch" "$prompt" "$log")"
  else
    echo "Invalid multiplexer $CW_MULTIPLEXER" >&2
    return 1
  fi
}

# @cmd Internal, runs inside the one-shot pane created by `cw oneshot`. Runs setup + headless agent, tees all output to the durable log, then tears the worktree/window down.
# @arg    branch!                branch to open
# @arg    prompt!                Prompt to run
# @arg    log!                   Log to write to
__oneshot() {
  local branch="${argc_branch:-}"
  local prompt="${argc_prompt:-}"
  local log="${argc_log:-}"

  local status=0
  {
    echo "Starting $branch" &&
    date &&
    echo "Starting agent..." &&
    _run_agent_oneshot "$prompt" &&
    echo "Finishing $branch" &&
    date
  } 2>&1 | tee "$log" || status=$?

  printf '%s%s\n' "$CW_EXIT_PREFIX" "$status" | tee -a "$log"

  cw close
}

# @cmd Perform a code review of the given branch.
# @option -e --effort <LEVEL>    Review effort level (defaults to max)
# @arg    branch!                branch to open
review() {
  local branch="${argc_branch:-}"
  local effort="${argc_effort:-max}"
  cw create --prompt "/code-review $effort ; Print the findings in an easily readable format, with line numbers and suggested fixes." --background "$branch"
}

# @cmd Perform a code review of the given branch.
# @option -e --effort <LEVEL>    Review effort level (defaults to max)
# @arg    branch!                branch to open
review-oneshot() {
  local branch="${argc_branch:-}"
  local effort="${argc_effort:-max}"
  cw oneshot --prompt "/code-review $effort --comment" "$branch"
}

# @cmd Complete an instruction, push, and create a PR if it doesn't exist.
# @option -b --base <BRANCH>     base a new branch on this instead of trunk
# @option -p --prompt! <PROMPT>  Prompt to pass the LLM.
# @option -e --effort <LEVEL>    Review effort level (defaults to max)
# @arg    branch!                branch to open
quick() {
  local branch="${argc_branch:-}"
  local base="${argc_base:-}"
  local prompt="${argc_prompt:-}"
  local effort="${argc_effort:-}"
  cw create --prompt "$prompt. Then commit and push. Then /create-pr-stack" --background "$branch"
}

# @cmd Complete an instruction end to end, self-reviewing, pushing, and creating a PR.
# @option -b --base <BRANCH>     base a new branch on this instead of trunk
# @option -p --prompt! <PROMPT>  Prompt to pass the LLM.
# @option -e --effort <LEVEL>    Review effort level (defaults to max)
# @arg    branch!                branch to open
full() {
  local branch="${argc_branch:-}"
  local base="${argc_base:-}"
  local prompt="${argc_prompt:-}"
  local effort="${argc_effort:-}"
  cw create --prompt "$prompt. Then commit. Then do a /code-review $effort --fix $base . Then commit again and push. Then /create-pr-stack" --background "$branch"
}

# _parse_linear_ticket_id <ticket>
# Echo the upper-cased Linear ticket id (ACT-123) for <ticket>, which may be a
# bare id (act-123), a Linear branch name with or without its username prefix
# (colton/act-123-some-title), or an issue URL
# (https://linear.app/acme/issue/ACT-123/some-title).
_parse_linear_ticket_id() {
  local ticket="$1"
  ticket="${ticket%%[?#]*}"          # drop any query string or fragment
  ticket="${ticket%/}"
  if [[ "$ticket" == */issue/* ]]; then
    ticket="${ticket##*/issue/}"     # URL -> "ACT-123/some-title"
    ticket="${ticket%%/*}"
  else
    ticket="${ticket##*/}"           # branch -> drop the "colton/" prefix
  fi
  [[ "$ticket" =~ ^([A-Za-z][A-Za-z0-9]*-[0-9]+)([-_.]|$) ]] \
    || die "can't parse a linear ticket id from '$1'."
  echo "${BASH_REMATCH[1]^^}"
}

# @cmd Complete a linear task end to end, self-reviewing, pushing, and creating a PR.
# @option -b --base <BRANCH>     base a new branch on this instead of trunk
# @option -e --effort <LEVEL>    Review effort level (defaults to max)
# @arg    tickets*                tickets to open
linear() {
  local base="${argc_base:-}"
  local effort="${argc_effort:-}"

  if [ -z "${argc_tickets:-}" ] ; then
    die "at least one linear ticket required"
  fi

  for ticket in "${argc_tickets[@]}" ; do
    local ticket_id
    ticket_id="$(_parse_linear_ticket_id "$ticket")"
    branch="${USER,,}/${ticket_id,,}"
    cw full --prompt "Complete the linear ticket $ticket_id" "$branch"
  done
}

eval "$(argc --argc-eval "$0" "$@")"
