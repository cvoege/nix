#!/usr/bin/env bash
# @describe Create coding workspaces with tmux + an agent harness

CW_LOG_DIR="${CW_LOG_DIR:-$HOME/.cw/logs}"
CW_EXIT_PREFIX="cw: oneshot exit "
CW_AGENT="${CW_AGENT:-claude}"
# tmux or herdr
CW_MULTIPLEXER="${CW_MULTIPLEXER:-herdr}"

set -euo pipefail

die() { echo "cw: $*" >&2; exit 1; }

if [ "${BASH_VERSINFO[0]:-0}" -lt 5 ]; then
  die "needs bash 5+ (running ${BASH_VERSION}); got /bin/bash?"
fi

# _cw_window_name <branch>
# Echo the tmux window name for <branch>: the branch name lowercased with
# slashes turned into dashes, except that branches shaped like
# colton/act-123-whatever collapse to the ticket id (ACT-123). One-shot log
# filenames are derived from this too, which is how `cw wait <branch>` finds
# the log of a run it didn't start.
_cw_window_name() {
  local branch="$1"
  if [[ "$branch" =~ ^[a-z]+/([a-z]+-[0-9]+)-.* ]]; then
    echo "${BASH_REMATCH[1]}" | tr '[:lower:]' '[:upper:]' | tr '/' '-'
  else
    echo "$branch" | tr '[:upper:]' '[:lower:]' | tr '/' '-'
  fi
}

# _cw_agent_name <window>
# Echo a herdr-legal agent name for <window>. herdr requires 1-32 characters of
# lowercase letters, digits, '-' or '_', starting with a lowercase letter, but
# window names are upper-cased ticket ids (CHAT-4765) — so lowercase, replace
# every other character with '-', and prefix a letter if it starts with a digit.
_cw_agent_name() {
  local name="${1,,}"
  name="${name//[^a-z0-9_-]/-}"
  [[ "$name" =~ ^[a-z] ]] || name="a-$name"
  echo "${name:0:32}"
}


# _cw_pin_window_dir_tmux <window_id> <dir>
# Record <dir> as the window's split directory. `new-window -c` only sets the
# FIRST pane's directory; a later `split-window` with no -c uses the session's
# working directory, not the window's or the pane's. The split key bindings read
# this window-scoped user option (see programs.tmux in home.nix) so every pane
# in a cw window lands in the worktree — and windows without it are untouched.
_cw_pin_window_dir_tmux() {
  tmux set-option -w -t "$1" @cw_dir "$2"
}

# _cw_retry <attempts> <delay_seconds> <cmd> [args…]
# Run <cmd> until it succeeds, up to <attempts> times, sleeping <delay> between
# tries. Returns the last exit status if every attempt fails.
_cw_retry() {
  local attempts="$1" delay="$2"; shift 2
  local i=1 status=0
  while :; do
    if "$@"; then return 0; fi
    status=$?
    if [ "$i" -ge "$attempts" ]; then
      echo "cw: '$*' failed after $attempts attempt(s)" >&2
      return "$status"
    fi
    echo "cw: '$*' failed (attempt $i/$attempts); retrying in ${delay}s" >&2
    i=$((i + 1))
    sleep "$delay"
  done
}

_get_agent_basic_cmd() {
  local prompt="$1" cmd
  if [ "$CW_AGENT" = "claude" ] ; then
    cmd="claude"
    [ -n "$prompt" ] && cmd="claude --permission-mode auto $(printf '%q' "$prompt")"
    echo "$cmd"
  elif [ "$CW_AGENT" = "opencode" ] ; then
    cmd="ANTHROPIC_API_KEY=x ANTHROPIC_BASE_URL=http://127.0.0.1:3456 opencode"
    [ -n "$prompt" ] && cmd="ANTHROPIC_API_KEY=x ANTHROPIC_BASE_URL=http://127.0.0.1:3456 opencode $(printf '%q' "$prompt")"
    echo "$cmd"
  else
    echo "Invalid agent $CW_AGENT" >&2
  fi
}
_run_agent_oneshot() {
  local prompt="$1"
  if [ "$CW_AGENT" = "claude" ] ; then
    claude --output-format stream-json --verbose --permission-mode auto -p "$prompt"
  elif [ "$CW_AGENT" = "opencode" ] ; then
    ANTHROPIC_API_KEY=x ANTHROPIC_BASE_URL=http://127.0.0.1:3456 opencode --prompt "$prompt"
  else
    echo "Invalid agent $CW_AGENT" >&2
  fi
}

