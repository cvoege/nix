#!/usr/bin/env python3
"""cwtail — pretty-print / follow a `cw oneshot` log.

A cw oneshot log is a tee of shell setup output plus Claude's
`--output-format stream-json` events (one JSON object per line). This renders
those events in a readable, colorized form and passes non-JSON setup lines
through dimmed.

Usage:
  cwtail [-f|--follow] [--no-follow] [--raw-setup] [FILE|SUBSTRING]

  FILE|SUBSTRING  A log path, or a substring matched against files in
                  $CW_LOG_DIR (default ~/.cw/logs). Omit to use the newest log.

By default the whole log is rendered and cwtail exits; on a still-running log
it keeps following until the run's `result` event (or Ctrl-C).
"""
import glob
import json
import os
import re
import sys
import time

LOG_DIR = os.environ.get("CW_LOG_DIR", os.path.expanduser("~/.cw/logs"))

# --- colors ---------------------------------------------------------------
USE_COLOR = sys.stdout.isatty() or os.environ.get("CLICOLOR_FORCE")


def c(code):
    return (lambda s: f"\033[{code}m{s}\033[0m") if USE_COLOR else (lambda s: s)


DIM = c("2")
BOLD = c("1")
CYAN = c("36")
GREEN = c("32")
YELLOW = c("33")
RED = c("31")
BLUE = c("34")
MAGENTA = c("35")

ANSI_RE = re.compile(r"\033\[[0-9;]*[A-Za-z]")
# A table/TUI frame line: starts with a box-drawing border glyph (doppler
# secret tables, turbo TUI). Dropping these strips the setup noise.
BOX_RE = re.compile(r"^\s*[─│┌┐└┘├┤┬┴┼╭╮╰╯▀-▟⠀-⣿]")


def strip_ansi(s):
    return ANSI_RE.sub("", s)


def indent(text, prefix="    "):
    return "\n".join(prefix + ln for ln in text.splitlines())


def bullet(text, marker="  ⎿ ", cont="     "):
    """Prefix the first line with `marker`, continuation lines with `cont`."""
    lines = text.splitlines() or [""]
    return "\n".join(
        (marker if i == 0 else cont) + ln for i, ln in enumerate(lines)
    )


def truncate(text, max_lines=12):
    lines = text.splitlines()
    if len(lines) <= max_lines:
        return text
    hidden = len(lines) - max_lines
    return "\n".join(lines[:max_lines] + [DIM(f"… {hidden} more lines")])


# --- renderers ------------------------------------------------------------

def render_system(d):
    sub = d.get("subtype")
    if sub == "init":
        model = d.get("model", "?")
        cwd = d.get("cwd", "")
        tools = d.get("tools") or []
        return (
            BOLD(CYAN("● session")) + f"  {MAGENTA(model)}  "
            + DIM(f"{len(tools)} tools  {cwd}")
        )
    # hook_started / hook_response / thinking_tokens / everything else: quiet.
    return None


def _summarize_tool_input(name, inp):
    if not isinstance(inp, dict):
        return ""
    for key in ("command", "file_path", "path", "pattern", "query", "prompt", "url", "description"):
        if key in inp and isinstance(inp[key], str):
            v = inp[key].replace("\n", " ")
            return v[:120]
    return ", ".join(sorted(inp.keys()))[:120]


def render_assistant(d):
    out = []
    for b in d["message"].get("content", []):
        bt = b.get("type")
        if bt == "text":
            txt = b.get("text", "").strip()
            if txt:
                out.append(BOLD("⏺ ") + txt)
        elif bt == "thinking":
            lines = (b.get("thinking") or "").strip().splitlines()
            if lines:
                out.append(DIM("✱ thinking: " + lines[0][:100]))
        elif bt == "tool_use":
            name = b.get("name", "tool")
            summary = _summarize_tool_input(name, b.get("input"))
            out.append(GREEN("⏺ ") + BOLD(name) + DIM(f"({summary})"))
    return "\n".join(out) if out else None


def _tool_result_text(content):
    if isinstance(content, str):
        return content
    if isinstance(content, list):
        parts = []
        for b in content:
            if isinstance(b, dict):
                if b.get("type") == "text":
                    parts.append(b.get("text", ""))
                elif b.get("type") == "image":
                    parts.append("[image]")
            else:
                parts.append(str(b))
        return "\n".join(parts)
    return str(content)


def render_user(d):
    content = d["message"].get("content")
    if isinstance(content, str):
        return DIM(bullet(truncate(content)))
    out = []
    for b in content or []:
        if b.get("type") == "tool_result":
            txt = strip_ansi(_tool_result_text(b.get("content", ""))).rstrip()
            is_err = b.get("is_error")
            color = RED if is_err else DIM
            body = truncate(txt) if txt else "(no output)"
            out.append(color(bullet(body)))
    return "\n".join(out) if out else None


def render_result(d):
    ok = not d.get("is_error")
    head = GREEN("● done") if ok else RED("● failed")
    cost = d.get("total_cost_usd")
    turns = d.get("num_turns")
    dur = d.get("duration_ms")
    bits = []
    if turns is not None:
        bits.append(f"{turns} turns")
    if dur is not None:
        bits.append(f"{dur/1000:.0f}s")
    if cost is not None:
        bits.append(f"${cost:.3f}")
    line = head + "  " + DIM("  ".join(bits))
    res = d.get("result")
    if isinstance(res, str) and res.strip():
        line += "\n" + indent(res.strip(), "  ")
    return line


def render_json(d):
    t = d.get("type")
    if t == "system":
        return render_system(d)
    if t == "assistant":
        return render_assistant(d)
    if t == "user":
        return render_user(d)
    if t == "result":
        return render_result(d)
    if t == "rate_limit_event":
        return None  # noise
    return None


def render_line(raw, raw_setup):
    s = raw.rstrip("\n")
    if not s.strip():
        return None
    if s.lstrip().startswith("{"):
        try:
            return render_json(json.loads(s))
        except (json.JSONDecodeError, KeyError):
            pass
    # Non-JSON setup line.
    if not raw_setup:
        clean = strip_ansi(s)
        if not clean.strip() or BOX_RE.match(clean):
            return None  # drop doppler/turbo table frames
        if clean.strip() in ("Auto-selecting project from repo config file",
                              "Auto-selecting config from repo config file"):
            return None
        return DIM(clean)
    return s


# --- file selection & follow ---------------------------------------------

def pick_file(arg):
    if arg and os.path.isfile(arg):
        return arg
    candidates = sorted(glob.glob(os.path.join(LOG_DIR, "*.log")), key=os.path.getmtime)
    if arg:
        candidates = [f for f in candidates if arg in os.path.basename(f)]
        if not candidates:
            sys.exit(f"cwtail: no log in {LOG_DIR} matching {arg!r}")
    if not candidates:
        sys.exit(f"cwtail: no logs in {LOG_DIR}")
    return candidates[-1]


def emit(raw, raw_setup):
    rendered = render_line(raw, raw_setup)
    if rendered is not None:
        print(rendered, flush=True)


def is_result(raw):
    s = raw.strip()
    return s.startswith("{") and '"type":"result"' in s.replace(" ", "")


def main():
    follow = None  # None = auto (follow until result), True/False explicit
    raw_setup = False
    target = None
    for a in sys.argv[1:]:
        if a in ("-f", "--follow"):
            follow = True
        elif a in ("-n", "--no-follow"):
            follow = False
        elif a == "--raw-setup":
            raw_setup = True
        elif a in ("-h", "--help"):
            print(__doc__)
            return
        else:
            target = a

    path = pick_file(target)
    print(DIM(f"── {path}"), flush=True)

    with open(path, "r", errors="replace") as fh:
        saw_result = False
        for raw in fh:
            if is_result(raw):
                saw_result = True
            emit(raw, raw_setup)

        # If the run already finished, or the user asked not to follow, stop.
        if follow is False or (follow is None and saw_result):
            return

        # Follow: poll for appended lines until the result event (auto mode)
        # or forever (explicit -f). Ctrl-C to quit.
        try:
            while True:
                where = fh.tell()
                raw = fh.readline()
                if not raw:
                    time.sleep(0.4)
                    fh.seek(where)
                    continue
                emit(raw, raw_setup)
                if follow is None and is_result(raw):
                    return
        except KeyboardInterrupt:
            pass


if __name__ == "__main__":
    try:
        main()
    except (BrokenPipeError, KeyboardInterrupt):
        try:
            sys.stdout.close()
        except Exception:
            pass
        os._exit(0)
