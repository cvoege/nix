#!/usr/bin/env bash
# @describe Manage a pool of reusable git worktrees for parallel work.

# shellcheck disable=SC2154

set -euo pipefail

die() { echo "ct: $*" >&2; exit 1; }

if [ "${BASH_VERSINFO[0]:-0}" -lt 5 ]; then
  die "needs bash 5+ (running ${BASH_VERSION}); got /bin/bash?"
fi

# Argument parsing is driven by argc (pkgs.argc, see home.nix): each subcommand
# is a function annotated with `# @cmd` / `# @option` / `# @arg` comments, from
# which argc builds the parser, generates `--help`, and dispatches. Descriptions
# are kept to one line each — argc reproduces a continuation line's leading
# whitespace verbatim, which comes out ragged in the generated help.
#
# Without argc on PATH the eval at the end of the file expands to nothing and ct
# would exit 0 having done nothing at all, so check up front.
command -v argc >/dev/null \
  || die "argc not found; ct needs it to parse arguments (nix: pkgs.argc)"

# _noargs <command> [<arg>...]
# Reject stray arguments to a subcommand that takes none. argc validates flags
# and declared positionals, but a command that declares no positional silently
# accepts them, so the arg-less subcommands call this.
_noargs() {
  local cmd="$1"; shift
  [ $# -eq 0 ] || die "$cmd: unexpected argument '$1'"
}

# _ct_main_root
# First entry of `git worktree list` is the main working tree
_ct_main_root() {
  git worktree list | awk 'NR==1{print $1}'
}

# --- worktree pool ---------------------------------------------------------
# ct keeps a pool of reusable worktrees named ct-worktree-N under
# <repo>-worktrees. An idle ("parked") worktree is checked out on its own
# marker branch, ct-worktree-N-parked, pointing at trunk; a busy one is on a
# real branch. Reusing a parked worktree keeps its node_modules and other
# ignored artifacts around for a fast warm `ct install`.
#
# Parking used to mean "detached HEAD", which conflated idleness with every
# other reason a worktree detaches: a rebase (git detaches HEAD for the whole
# operation), a bisect, or a plain `git checkout <sha>` to look at something.
# Those all read as parked, so `ct create` would claim them — silently stealing
# a bisect or an inspection, and hard-failing on a rebase ("cannot switch branch
# while rebasing") forever, since the same poisoned worktree was picked first
# every time. A marker branch is a positive assertion nothing else produces, and
# it self-heals: switch a parked worktree onto real work and it's busy again.
#
# The marker branch also makes claiming atomic, which matters because ct exists
# to run worktrees in parallel: a claim is a compare-and-swap delete of the
# marker ref (`git update-ref -d <ref> <old-sha>`), so exactly one of two
# concurrent `ct create`s can win a given worktree. Marker branches are local
# only and are deleted along with their worktree.

# _ct_pool_base
# Echo the worktree pool base dir (<repo_parent>/<repo_name>-worktrees),
# derived from the main working tree (first entry of `git worktree list`).
_ct_pool_base() {
  local main_root
  main_root="$(_ct_main_root)" || return 1
  echo "$(dirname "$main_root")/$(basename "$main_root")-worktrees"
}

# _ct_parked_branch <path-or-leaf>
# Echo the marker branch that means "this pool worktree is idle".
# e.g. _ct_parked_branch "/a/b/ct-worktree-1" -> "ct-worktree-1-parked"
# Deriving the name from the worktree leaf keeps it unique per worktree, which
# git requires: one branch can't be checked out in two worktrees at once.
_ct_parked_branch() {
  local leaf
  leaf="$(_ct_get_path_leaf "$1")"
  _ct_is_ct_worktree "$leaf" || return 1
  echo "$leaf-parked"
}

# _ct_worktree_busy <path>
# True when a worktree must not be touched: a git operation is mid-flight, or
# it holds uncommitted work. Parked worktrees are clean by construction, so
# either condition means something unexpected is going on and we leave it be.
_ct_worktree_busy() {
  local wt="$1" gitdir f
  gitdir="$(git -C "$wt" rev-parse --absolute-git-dir 2>/dev/null)" || return 0
  for f in rebase-merge rebase-apply MERGE_HEAD CHERRY_PICK_HEAD REVERT_HEAD BISECT_LOG; do
    [ -e "$gitdir/$f" ] && return 0
  done
  [ -n "$(git -C "$wt" status --porcelain 2>/dev/null)" ] && return 0
  return 1
}

# _ct_list_parked
# Echo the path of every parked pool worktree, one per line: a worktree under
# the pool base whose leaf matches ct-worktree-N and which is checked out on
# that worktree's own marker branch. Anything else — a real branch, a detached
# HEAD from a rebase or a manual checkout — is not parked.
_ct_list_parked() {
  local base
  base="$(_ct_pool_base)" || return 1
  git worktree list --porcelain | awk -v base="$base" '
    function flush() {
      if (path != "" && branch != "") {
        n = split(path, parts, "/"); leaf = parts[n]
        if (leaf ~ /^ct-worktree-[0-9]+$/ && index(path, base "/") == 1 &&
            branch == "refs/heads/" leaf "-parked") print path
      }
      path = ""; branch = ""
    }
    /^worktree / { flush(); path = substr($0, 10) }
    /^branch /   { branch = substr($0, 8) }
    END          { flush() }
  '
}

# _ct_list_detached
# Echo "<path>\t<HEAD sha>" for every pool worktree in detached HEAD. Only used
# to find pre-marker-branch worktrees to adopt; see _ct_adopt_parked.
_ct_list_detached() {
  local base
  base="$(_ct_pool_base)" || return 1
  git worktree list --porcelain | awk -v base="$base" '
    function flush() {
      if (path != "" && detached) {
        n = split(path, parts, "/"); leaf = parts[n]
        if (leaf ~ /^ct-worktree-[0-9]+$/ && index(path, base "/") == 1)
          printf "%s\t%s\n", path, head
      }
      path = ""; head = ""; detached = 0
    }
    /^worktree / { flush(); path = substr($0, 10) }
    /^HEAD /     { head = substr($0, 6) }
    /^detached$/ { detached = 1 }
    END          { flush() }
  '
}

# _ct_park_worktree <worktree> <trunk>
# Put a worktree into the parked state: on its marker branch, at trunk. `switch
# -C` creates or resets the branch, so this is idempotent.
_ct_park_worktree() {
  local wt="$1" trunk="$2" parked
  parked="$(_ct_parked_branch "$wt")" || return 1
  git -C "$wt" switch --quiet -C "$parked" "$trunk"
}

# _ct_delete_parked_branch <main_root> <worktree>
# Drop a worktree's marker branch, if it has one. Call only once the worktree
# itself is gone — git refuses to delete a branch that's checked out.
_ct_delete_parked_branch() {
  local main_root="$1" parked
  parked="$(_ct_parked_branch "$2")" || return 0
  git -C "$main_root" show-ref --verify --quiet "refs/heads/$parked" || return 0
  git -C "$main_root" branch --quiet -D "$parked" ||
    echo "ct: could not delete marker branch '$parked'" >&2
}

# _ct_adopt_parked <trunk>
# Migrate worktrees parked by an older ct, which left them in detached HEAD, to
# the marker branch. Deliberately conservative: only a worktree sitting exactly
# at trunk — which is what the old park produced — is adopted. A worktree
# detached anywhere else is someone mid-rebase or inspecting a commit, so it is
# left alone and simply never enters the pool.
_ct_adopt_parked() {
  local trunk="$1" trunk_sha path head
  trunk_sha="$(git rev-parse --verify --quiet "$trunk^{commit}")" || return 0
  while IFS=$'\t' read -r path head; do
    [ -n "$path" ] || continue
    [ "$head" = "$trunk_sha" ] || continue
    if _ct_worktree_busy "$path"; then continue; fi
    if _ct_park_worktree "$path" "$trunk"; then
      echo "ct: adopted previously parked $(_ct_get_path_leaf "$path")"
    fi
  done < <(_ct_list_detached)
}

# _ct_claim <worktree>
# Take ownership of a parked worktree, atomically. Deleting the marker ref with
# its expected old value is a compare-and-swap: two concurrent `ct create`s race
# on it and exactly one wins, so they can't both switch the same worktree onto
# different branches. Returns non-zero if the worktree isn't claimable.
_ct_claim() {
  local wt="$1" parked sha
  parked="$(_ct_parked_branch "$wt")" || return 1
  if _ct_worktree_busy "$wt"; then return 1; fi
  sha="$(git rev-parse --verify --quiet "refs/heads/$parked")" || return 1
  git update-ref -d "refs/heads/$parked" "$sha" 2>/dev/null
}

# _ct_unclaim <worktree> <trunk>
# Undo a claim: put the worktree back in the pool after a failure between
# claiming it and checking out the requested branch. Without this the marker
# branch stays deleted and the worktree is never reused again.
_ct_unclaim() {
  _ct_park_worktree "$1" "$2" ||
    echo "ct: could not return '$1' to the pool; run: ct park '$1'" >&2
}

# _ct_find_parked
# Claim and echo a parked pool worktree, or nothing if none could be taken.
# Candidates are tried in turn rather than only the first, so one worktree left
# dirty or mid-operation can't block the whole pool.
_ct_find_parked() {
  local path
  while IFS= read -r path; do
    [ -n "$path" ] || continue
    if _ct_claim "$path"; then echo "$path"; return 0; fi
  done < <(_ct_list_parked)
}

# _ct_get_path_leaf <path>
# Echoes the last element of a path
# e.g. ct_get_path "/a/b/c" -> "c"
_ct_get_path_leaf() {
  echo "${1##*/}"
}

# _ct_get_worktree_number <path>
# echo N if the path is a ct-worktree-N, else fail.
# e.g. _ct_get_worktree_number "/a/b/ct-worktree-1" -> "1"
# e.g. _ct_get_worktree_number "ct-worktree-1" -> "1"
# e.g. _ct_get_worktree_number "asdf" -> fail
_ct_get_worktree_number() {
  [[ "$(_ct_get_path_leaf "$1")" =~ ^ct-worktree-([0-9]+)$ ]] || return 1
  echo "${BASH_REMATCH[1]}"
}

# _ct_is_ct_worktree <path>
# Checks if the given path is a ct worktree
# e.g. ct_get_path "/a/b/ct-worktree-1" -> true
# e.g. ct_get_path "ct-worktree-1" -> true
# e.g. ct_get_path "asdf" -> fail
_ct_is_ct_worktree() {
  _ct_get_worktree_number "$1" >/dev/null
}

# _ct_next_worktree_number
# Echo the next free pool number: one past the highest ct-worktree-N seen among
# both registered worktrees and any leftover dirs under the base.
_ct_next_worktree_number() {
  local base n max=0 path
  base="$(_ct_pool_base)" || return 1

  # Check actual worktrees
  while IFS= read -r path; do
    if _ct_is_ct_worktree "$path" ; then
      n="$(_ct_get_worktree_number "$path")"
      if (( n > max )); then max=$n; fi
    fi
  done < <(git worktree list --porcelain | awk '/^worktree /{print substr($0, 10)}')

  # Check leftover dirs
  if [ -d "$base" ]; then
    for path in "$base"/ct-worktree-*; do
      [ -e "$path" ] || continue
      if _ct_is_ct_worktree "$path" ; then
        n="$(_ct_get_worktree_number "$path")"
        if (( n > max )); then max=$n; fi
      fi
    done
  fi

  echo $(( max + 1 ))
}


# Absolute path of this script. A ct shell calls back into the *same* ct that
# spawned it (CT_BIN below) rather than whatever `ct` PATH resolves to, so a
# stale install or an edited PATH can't answer the release checks for a shell
# this copy is managing.
_ct_self="$(cd -P "$(dirname "$0")" 2>/dev/null && pwd)/$(basename "$0")"

# ct install
# Prepares a worktree by checking the main working tree for a local
# .local/ct_install.sh. If present, runs it with the current worktree as its
# working directory. The script is a per-machine, untracked setup step (deps,
# configs) that a fresh pool worktree wouldn't otherwise have; running the
# canonical copy in the main tree keeps a single source of truth.
ct_install() {
  local main_root worktree src
  worktree="$(git rev-parse --show-toplevel)" || return 1
  # First entry of `git worktree list` is the main working tree
  main_root="$(_ct_main_root)" || return 1
  src="$main_root/.local/ct_install.sh"

  if [ ! -f "$src" ]; then
    echo "ct install: no .local/ct_install.sh in $main_root; nothing to do"
    return 0
  fi

  # Pass the main working tree path as $1 so the script can reach the original
  # repo (e.g. to copy over untracked local files).
  echo "ct install: running $src"
  ( cd "$worktree" && bash "$src" "$main_root" )
}

# Open a worktree on <branch>, creating the branch off --base (or trunk) when it
# doesn't exist yet.

# @cmd    Open a worktree on a branch (new or existing)
# @alias start
# @option -b --base <BRANCH>  base a new branch on this instead of trunk
# @arg    branch!             branch to open
create() {
  local branch="$argc_branch" base="${argc_base:-}"
  local main_root trunk worktree

  main_root="$(_ct_main_root)" || return 1

  # Fetch so we know whether the branch exists on origin, and so we base
  # new branches on the latest trunk.
  git fetch origin --quiet

  # trunk is needed both for basing new branches and for `git stack parent`.
  trunk="$(git stack trunk)"
  if [ -z "$trunk" ]; then
    echo "ct: could not determine origin's default branch" >&2
    return 1
  fi

  # Does the requested branch already exist? Decided up front because it also
  # decides whether --base applies: re-opening an existing branch never rebases
  # or re-parents it, so its base is irrelevant and the flag is ignored.
  local exists=0
  if git show-ref --verify --quiet "refs/heads/$branch" ||
      git ls-remote --exit-code --heads origin "$branch" >/dev/null 2>&1; then
    exists=1
  fi

  # If the branch already exists, --base is an invalid option, error rather than proceed
  if [ "$exists" -eq 1 ] && [ -n "$base" ] && [ "$base" != "$trunk" ] ; then
    echo "ct: can not pass '--base' with a branch that already exists" >&2
    return 1
  fi


  # Start point for a new branch: --base when given, else the latest trunk.
  # Resolved and validated *before* acquiring a worktree so a bad --base fails
  # without leaving a freshly created worktree behind.
  local base_ref="$trunk"
  if [ "$exists" -eq 0 ] && [ -n "$base" ]; then
    if ! git show-ref --verify --quiet "refs/heads/$base"; then
      if git rev-parse --verify --quiet "refs/remotes/origin/$base" >/dev/null; then
        # Remote-only base: materialise it locally. It has to be a local ref to
        # serve as a `git stack parent` target, which git-stack requires.
        git branch --quiet --track "$base" "origin/$base" || return 1
      else
        echo "ct: base branch '$base' does not exist locally or on origin" >&2
        return 1
      fi
    fi
    base_ref="$base"
  fi

  # Bring any worktree parked by an older ct into the pool before looking for
  # one, so upgrading doesn't strand warm worktrees.
  _ct_adopt_parked "$trunk"

  # Acquire a worktree from the pool: claim a parked one if any, otherwise add a
  # fresh ct-worktree-N. A new worktree is born parked and then claimed through
  # the same compare-and-swap, so a concurrent `ct create` can't grab it in the
  # window before we switch it onto the branch.
  worktree="$(_ct_find_parked)"
  if [ -z "$worktree" ]; then
    # Named pool_base, not base: `base` is this function's <base> parameter.
    local pool_base n
    pool_base="$(_ct_pool_base)" || return 1
    n="$(_ct_next_worktree_number)" || return 1
    worktree="$pool_base/ct-worktree-$n"
    # -B, not -b: a worktree deleted by hand (rm -rf + git worktree prune) leaves
    # its marker branch behind, and the number gets reused once the dir is gone.
    # -B resets that stale ref instead of failing the whole create.
    git worktree add -B "ct-worktree-$n-parked" "$worktree" "$trunk" || return 1
    _ct_claim "$worktree" || {
      echo "ct: '$worktree' was taken by a concurrent ct; retry" >&2
      return 1
    }
  fi

  # Point the acquired worktree at the requested branch. `git switch` reconciles
  # tracked files while leaving ignored artifacts (node_modules, .clasp.json)
  # in place. If the branch is already checked out in another worktree, this
  # fails — same "can't open a branch twice" behavior as before.
  #
  # The worktree is claimed from here on: its marker branch is gone, so nothing
  # else can take it, and every failure path has to park it again or it leaks
  # out of the pool for good.
  if [ "$exists" -eq 1 ]; then
    if git rev-parse --verify --quiet "refs/remotes/origin/$branch" >/dev/null; then
      if git show-ref --verify --quiet "refs/heads/$branch"; then
        git fetch origin "$branch:$branch" 2>/dev/null ||
          echo "ct: could not fast-forward '$branch' to origin/$branch; using the local branch" >&2
      else
        git branch --quiet --track "$branch" "origin/$branch" ||
          { _ct_unclaim "$worktree" "$trunk"; return 1; }
      fi
    fi
    git -C "$worktree" switch "$branch" || { _ct_unclaim "$worktree" "$trunk"; return 1; }
  else
    # New branch, based on --base (or the latest trunk) and recorded as stacked
    # on it so `git stack` sees it. The ref check keeps the parent step from
    # failing the whole open when trunk has no local branch — git-stack only
    # accepts a local branch as a parent.
    git -C "$worktree" switch -c "$branch" "$base_ref" ||
      { _ct_unclaim "$worktree" "$trunk"; return 1; }
    if git show-ref --verify --quiet "refs/heads/$base_ref"; then
      git -C "$worktree" stack parent "$base_ref" || return 1
    fi
  fi

  echo "Worktree created: $worktree"
  cd "$worktree"
  echo "Running install..."
  ct_install || { echo "Failed install in $worktree" >&2; return 1; }
  echo "Install complete!"
  echo "cd $worktree"
}

# _ct_registered_paths
# Echo the path of every worktree registered in this repo, one per line.
_ct_registered_paths() {
  git worktree list --porcelain | awk '/^worktree /{print substr($0, 10)}'
}

# _ct_worktree_for_branch <branch>
# Echo the path of the worktree that has <branch> checked out, if any.
_ct_worktree_for_branch() {
  git worktree list --porcelain | awk -v ref="refs/heads/$1" '
    /^worktree /{ wt = substr($0, 10) }
    $1 == "branch" && $2 == ref { print wt; exit }
  '
}

# _ct_resolve_target <target>
# Echo the absolute path of the worktree <target> names. Accepts, in precedence
# order: a path to (or inside) a registered worktree, a pool worktree leaf name
# (ct-worktree-N), or a branch currently checked out in a worktree. Precedence
# only matters for pathological names — a branch called ct-worktree-3, or one
# that matches a directory in the cwd — and each form is only accepted if it
# resolves to a worktree of *this* repo, so a miss falls through to the next.
_ct_resolve_target() {
  local target="$1" abs top pool path

  # 1. a path to, or inside, a worktree
  if [ -d "$target" ]; then
    abs="$(cd -P "$target" 2>/dev/null && pwd)" || abs=""
    if [ -n "$abs" ]; then
      top="$(git -C "$abs" rev-parse --show-toplevel 2>/dev/null || true)"
      if [ -n "$top" ] && _ct_is_registered "$top"; then echo "$top"; return 0; fi
    fi
  fi

  # 2. a pool worktree leaf name
  if _ct_is_ct_worktree "$target"; then
    pool="$(_ct_pool_base)" || return 1
    if _ct_is_registered "$pool/$target"; then echo "$pool/$target"; return 0; fi
  fi

  # 3. a branch that some worktree has checked out
  path="$(_ct_worktree_for_branch "$target")"
  if [ -n "$path" ]; then echo "$path"; return 0; fi

  echo "ct: '$target' doesn't name a worktree of this repo (tried it as a path, a" >&2
  echo "  pool worktree name, and a checked-out branch)." >&2
  return 1
}

# _ct_is_registered <path>
_ct_is_registered() {
  local want="$1" path
  while IFS= read -r path; do
    [ "$path" = "$want" ] && return 0
  done < <(_ct_registered_paths)
  return 1
}

# _ct_release_check <worktree> <force> <remove>
# Return 0 if <worktree> can be released, else explain why not on stderr.
# Mutates nothing.
_ct_release_check() {
  local worktree="$1" force="$2" remove="$3"
  local main_root pool_base

  main_root="$(_ct_main_root)" || return 1
  pool_base="$(_ct_pool_base)" || return 1

  # Only operate on ct worktrees: those living somewhere under <repo>-worktrees,
  # next to the main tree. The first test also refuses to act on the main tree.
  if [ "$worktree" = "$main_root" ] || [[ "$worktree"/ != "$pool_base"/* ]]; then
    echo "ct: '$worktree' is not a ct worktree" >&2
    return 1
  fi

  # An in-progress operation is checked before dirtiness, because a conflicted
  # rebase makes the tree dirty too and "commit them, or pass -f" is the wrong
  # advice for it — -f discards uncommitted changes, not an in-flight rebase, so
  # it would fall through to a `git switch` git refuses ("cannot switch branch
  # while rebasing"). Removal doesn't care: the whole worktree is going away.
  if [ -z "$remove" ] && _ct_is_ct_worktree "$worktree"; then
    local gitdir f
    gitdir="$(git -C "$worktree" rev-parse --absolute-git-dir 2>/dev/null)" || gitdir=""
    for f in rebase-merge rebase-apply MERGE_HEAD CHERRY_PICK_HEAD REVERT_HEAD BISECT_LOG; do
      if [ -n "$gitdir" ] && [ -e "$gitdir/$f" ]; then
        echo "ct: '$worktree' has a git operation in progress; finish or abort it" >&2
        echo "  (git rebase --abort / git cherry-pick --abort / git bisect reset), or pass -r to remove" >&2
        return 1
      fi
    done
  fi

  # status --porcelain ignores gitignored files, so node_modules et al. don't
  # count as dirty — only real uncommitted/untracked work blocks a release.
  if [ -n "$(git -C "$worktree" status --porcelain)" ] && [ -z "$force" ]; then
    echo "ct: '$worktree' has uncommitted changes; commit them, or pass -f to discard" >&2
    return 1
  fi

  if [ -z "$remove" ] && _ct_is_ct_worktree "$worktree"; then
    if [ -z "$(git -C "$main_root" stack trunk)" ]; then
      echo "ct: could not determine trunk, so the worktree can't be parked" >&2
      return 1
    fi
  fi
  return 0
}

# _ct_release <worktree> <force> <remove>
# Park <worktree> (marker branch at trunk, keeping the dir and its warm deps)
# or, with <remove>, delete it. Assumes _ct_release_check has just passed.
_ct_release() {
  local worktree="$1" force="$2" remove="$3"
  local main_root trunk leaf
  main_root="$(_ct_main_root)" || return 1

  # Never act on a worktree we're standing in: a remove would delete the cwd out
  # from under this process.
  cd "$main_root" || return 1

  leaf="$(_ct_get_path_leaf "$worktree")"
  if [ -z "$remove" ] && _ct_is_ct_worktree "$leaf"; then
    trunk="$(git -C "$main_root" stack trunk)"
    if [ -n "$(git -C "$worktree" status --porcelain)" ]; then
      # Only reachable with force (the check refuses otherwise): discard tracked
      # changes and untracked files, but keep ignored ones (node_modules) so the
      # parked worktree stays warm.
      git -C "$worktree" reset --hard
      git -C "$worktree" clean -fd
    fi
    if ! _ct_park_worktree "$worktree" "$trunk"; then
      echo "ct: failed to park '$worktree'" >&2
      return 1
    fi
    echo "ct: parked $leaf (on $(_ct_parked_branch "$leaf") at $trunk)"
  else
    # Remove entirely: explicit --remove, or a legacy (non-pool) worktree.
    # $force is deliberately unquoted: it's either "--force" or empty, and an
    # empty quoted arg would be passed to git as a bogus worktree path.
    # shellcheck disable=SC2086
    if ! git -C "$main_root" worktree remove $force "$worktree"; then
      echo "ct: worktree not removed: '$worktree' (pass -f to discard changes)" >&2
      return 1
    fi
    # The marker branch outlives the worktree it named; drop it so refs don't
    # pile up. Only reachable once the worktree is gone, so -D always applies.
    _ct_delete_parked_branch "$main_root" "$worktree"
    echo "ct: removed $worktree"
  fi
}

# Release a worktree: park it by default (marker branch at trunk, dir kept with
# its deps for a fast warm reuse), or delete it with --remove. Without a target it's
# the worktree you're currently in, which is what the `close` alias is for.
# --check runs the refusal checks and stops there, changing nothing — it's how
# `ctclose` validates a release from inside the shell being released.

# @cmd   Release a worktree named by path, worktree name or branch
# @alias close
# @flag  -f --force   discard uncommitted and untracked changes
# @flag  -r --remove  delete the worktree instead of parking it for reuse
# @flag     --check   run the refusal checks only, changing nothing
# @arg   target       worktree path, ct-worktree-N or branch (default: current)
park() {
  local target="${argc_target:-}" remove="${argc_remove:-}" check="${argc_check:-}"
  # _ct_release passes $force to `git worktree remove` unquoted, so it has to be
  # the literal flag rather than a boolean.
  local force=""
  [ -n "${argc_force:-}" ] && force="--force"

  local worktree
  if [ -n "$target" ]; then
    worktree="$(_ct_resolve_target "$target")" || return 1
  else
    worktree="$(git rev-parse --show-toplevel 2>/dev/null)" || worktree=""
    if [ -z "$worktree" ]; then
      echo "ct: not inside a git worktree; pass a worktree, branch or path to park" >&2
      return 1
    fi
  fi

  _ct_release_check "$worktree" "$force" "$remove" || return 1
  [ -n "$check" ] && return 0
  _ct_release "$worktree" "$force" "$remove"
}

# Removes every parked pool worktree, reclaiming disk (its marker branch goes
# with it). Busy worktrees — on a real branch, or detached mid-rebase — are left
# untouched. Parked trees are clean, so no --force is needed. Runnable from
# anywhere in the repo.

# @cmd Remove all parked (idle) worktrees
clean() {
  _noargs clean "$@"
  local main_root trunk path removed=0
  main_root="$(_ct_main_root)"

  # Sweep worktrees parked by an older ct too, rather than leaving them behind
  # forever: they're idle by the same definition, just recorded differently.
  trunk="$(git -C "$main_root" stack trunk 2>/dev/null || true)"
  [ -n "$trunk" ] && _ct_adopt_parked "$trunk"

  while IFS= read -r path; do
    [ -n "$path" ] || continue
    if git -C "$main_root" worktree remove "$path"; then
      removed=$(( removed + 1 ))
      _ct_delete_parked_branch "$main_root" "$path"
      echo "ct clean: removed $path"
    else
      echo "ct clean: could not remove $path" >&2
    fi
  done < <(_ct_list_parked)

  git -C "$main_root" worktree prune
  echo "ct clean: removed $removed parked worktree(s)"
}

# The one command that stays a wrapper: ct_install has a second caller (the end
# of a successful `create`), and naming the function `install` outright would
# shadow install(1) for the rest of this script.

# @cmd Prepare the current worktree (deps + configs)
install() { _noargs install "$@"; ct_install; }

# @cmd Get the worktree root
main_root() { _noargs main_root "$@"; _ct_main_root; }

# @cmd Get the worktree directory for the given branch
# @arg    branch!             branch to open
worktree_for_branch() {
  local branch="${argc_branch:-}"
  local worktree
  worktree="$(_ct_worktree_for_branch "$branch")"
  if [ -z "$worktree" ]; then
    echo "ct: Not worktree for branch $branch" >&2
    return 1
  fi

  echo "$worktree"
}

# @cmd Resolve the worktree for a given search string
# @arg target!    search string
resolve() {
  local target="${argc_target:-}"
  _ct_resolve_target "$target"
}

eval "$(argc --argc-eval "$0" "$@")"
