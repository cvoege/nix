// Zed settings
//
// For information on how to configure Zed, see the Zed
// documentation: https://zed.dev/docs/configuring-zed
//
// To see all of Zed's default settings without changing your
// custom settings, run `zed: open default settings` from the
// command palette (cmd-shift-p / ctrl-shift-p)
{
  "cli_default_open_behavior": "existing_window",
  "project_panel": {
    "dock": "left",
  },
  "outline_panel": {
    "dock": "left",
  },
  "collaboration_panel": {
    "dock": "left",
  },
  "git_panel": {
    "dock": "left",
  },
  "ssh_connections": [
    {
      "host": "pve",
      "username": "root",
      "args": [],
      "projects": [
        {
          "paths": ["/root/./"],
        },
        {
          "paths": ["/root/any-sync-dockercompose"],
        },
        {
          "paths": ["/root/homelab/./"],
        },
      ],
    },
    {
      "host": "pve2",
      "username": "root",
      "args": [],
      "projects": [
        {
          "paths": ["/root/homelab/./"],
        },
      ],
    },
    {
      "host": "pve3",
      "username": "root",
      "args": [],
      "projects": [
        {
          "paths": ["/root/homelab"],
        },
      ],
    },
    // Right now connecting via ssh is a bit broken to a mac, the server binary download doesn't work.
    // Can fix by downloading the right server release: https://github.com/zed-industries/zed/releases#release-v1.14.2
    // And putting it in the right location in ~/.zed_server. Will need to make it executable and give it the full
    // expected path, which is usually something like:
    // zed-remote-server-stable-1.14.2+stable.337.02abf5b08fa12c1c20a155ae3f796ef4c6c1a01e
    // You'll need to run ZED_LOG=debug zed --foreground to get that filename
    // be sure to chmod +x it.
    {
      "host": "calephmac",
      "username": "colton",
      "upload_binary_over_ssh": true,
      "projects": [{"paths": ["/Users/colton/code/monorepo"]}],
    },
  ],
  "extend_comment_on_newline": false,
  "search": {
    "case_sensitive": true,
  },
  "agent": {
    "dock": "right",
    "default_model": {
      "provider": "google",
      "model": "gemini-2.5-flash",
    },
    "model_parameters": [],
  },
  "agent_servers": {
    "claude-acp": {
      "favorite_config_option_values": {
        "model": ["sonnet"],
      },
      "type": "registry",
      "env": {
        "CLAUDE_CODE_EXECUTABLE": "/Users/colton/.local/bin/claude",
      },
    },
  },
  "file_types": {
    "ruby": ["*.jbuilder"],
  },
  "show_edit_predictions": false,
  "tab_size": 2,
  "preview_tabs": {
    "enable_preview_from_file_finder": false,
  },
  "minimap": {
    "show": "auto",
  },
  "gutter": {
    "line_numbers": true,
  },
  "telemetry": {
    "metrics": false,
    "diagnostics": false,
  },
  "base_keymap": "VSCode",
  "ui_font_size": 16,
  "buffer_font_size": 14.5,
  "theme": {
    "mode": "system",
    "light": "One Light",
    "dark": "One Dark",
  },
  "use_smartcase_search": false,
  "languages": {
    "Python": {
      "tab_size": 4,
      "language_servers": ["ruff", "pyright"],
      "format_on_save": "on",
      "formatter": [
        { "code_action": "source.organizeImports.ruff" },
        {
          "language_server": {
            "name": "ruff",
          },
        },
      ],
    },
    "Terraform": {
      "format_on_save": "on",
      "formatter": {
        "external": {
          "command": "tofu",
          "arguments": ["fmt", "-"],
        },
      },
    },
    "YAML": {
      "language_servers": ["yaml-language-server"],
    },
  },
  "lsp": {
    "pyright": {
      "settings": {
        "python.analysis": {
          "diagnosticMode": "openFilesOnly",
          "typeCheckingMode": "off",
        },
      },
    },
    "terraform-ls": {
      "initialization_options": {
        "experimentalFeatures": {
          "prefillRequiredFields": true,
        },
      },
    },
    "biome": {
      "settings": {
        "require_config_file": true,
      },
    },
    "yaml-language-server": {
      "settings": {
        "yaml": {
          "completion": true,
          "validate": true,
          "hover": true,
          "schemaStore": {
            "enable": true,
          },
          // "schemas": {
          //   "https://raw.githubusercontent.com/yannh/kubernetes-json-schema/master/v1.30.0-standalone-strict/all.json": [
          //     "*.yaml",
          //   ],
          // },
        },
      },
    },
  },
  "terminal": {
    "detect_venv": {
      "on": {
        // Default directories to search for virtual environments, relative
        // to the current working directory. We recommend overriding this
        // in your project's settings, rather than globally.
        "directories": [".env", "env", ".venv", "venv"],
        // Can also be `csh`, `fish`, and `nushell`
        "activate_script": "default",
      },
    },
  },
}
